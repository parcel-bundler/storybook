{
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "crates/parcel-plugin-*"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build": "yarn workspaces run build",
    "clean": "yarn workspaces run clean",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@swc/cli": "^0.5.1",
    "oxfmt": "^0.48.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.0.0",
    "storybook-builder-parcel": "*",
    "storybook-react-parcel": "*"
  },
  "resolutions": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "packageManager": "yarn@4.18.0",
  "@parcel/resolver-default": {
    "packageExports": true
  }
